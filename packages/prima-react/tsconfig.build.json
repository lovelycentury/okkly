{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "env.d.ts"],
  // Stories and unit tests live next to their component but are
  // workbench/test-only, as are the story helpers in src/storybook — keep them
  // out of the published bundle's type build.
  "exclude": [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/storybook/**"
  ]
}
