{
  "name": "@okkly/vue-composables",
  "version": "0.1.0",
  "description": "Okryshto design system — headless Vue composables",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovelycentury/okkly.git",
    "directory": "packages/vue-composables"
  },
  "homepage": "https://github.com/lovelycentury/okkly/tree/main/packages/vue-composables#readme",
  "bugs": "https://github.com/lovelycentury/okkly/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
