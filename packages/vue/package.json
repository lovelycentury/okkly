{
  "name": "@okkly/vue",
  "version": "0.1.2",
  "description": "Okryshto design system — Vue component library",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovelycentury/okkly.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/lovelycentury/okkly/tree/main/packages/vue#readme",
  "bugs": "https://github.com/lovelycentury/okkly/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/okkly-vue.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts",
    "dev": "vite build --config vite.lib.config.ts --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --config ../oxlint-config/index.json .",
    "storybook": "storybook dev -p 6008 --no-open",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@okkly/design-system": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^25.0.1",
    "sass-embedded": "catalog:",
    "storybook": "^10.6.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.42",
    "vue-tsc": "^3.2.0"
  },
  "peerDependencies": {
    "vue": ">=3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
