{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "env.d.ts"],
  // Stories, component tests and their helpers live next to the sources but are
  // workbench/test-only — keep them out of the published bundle's type build.
  "exclude": ["src/**/*.stories.ts", "src/**/*.spec.ts", "src/**/*.ct.ts", "src/playwright/**"]
}
