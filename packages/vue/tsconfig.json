{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "types": ["vite/client"],
    // The package root, not `src`: this config also covers `.storybook` and
    // `vitest.setup.ts`. tsconfig.build.json narrows both to `src`.
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "env.d.ts", ".storybook/**/*.ts", "vitest.setup.ts"]
}
