{
  "name": "@okkly/svelte",
  "version": "0.1.2",
  "description": "Okryshto design system — Svelte component library",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovelycentury/okkly.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/lovelycentury/okkly/tree/main/packages/svelte#readme",
  "bugs": "https://github.com/lovelycentury/okkly/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.harness.*",
    "!dist/**/*.stories.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/okkly-svelte.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist && pnpm run build:styles",
    "build:styles": "sass --no-source-map --load-path=node_modules styles.scss dist/okkly-svelte.css",
    "dev": "svelte-package -i src -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "lint": "oxlint --config ../oxlint-config/index.json .",
    "storybook": "storybook dev -p 6009 --no-open",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@okkly/design-system": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-svelte-csf": "^5.1.3",
    "@storybook/svelte": "^10.6.0",
    "@storybook/svelte-vite": "^10.6.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^25.0.1",
    "sass-embedded": "catalog:",
    "storybook": "^10.6.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
