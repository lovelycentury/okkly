{
  "name": "@okkly/react",
  "version": "0.1.1",
  "description": "Okryshto design system \u2014 React component library",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovelycentury/okkly.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/lovelycentury/okkly/tree/main/packages/react#readme",
  "bugs": "https://github.com/lovelycentury/okkly/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/okkly-react.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --config ../oxlint-config/index.json --ignore-pattern \"playwright/.cache/**\" --ignore-pattern \"playwright-report/**\" --ignore-pattern \"test-results/**\" --ignore-pattern \"blob-report/**\" .",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "test:playwright": "playwright install --with-deps chromium && playwright test",
    "test:playwright:update": "PW_UPDATE_SNAPSHOTS=true CI=true playwright test"
  },
  "dependencies": {
    "@maskito/core": "^5.3.1",
    "@maskito/kit": "^5.3.1",
    "@maskito/react": "^5.3.1",
    "@okkly/design-system": "workspace:*",
    "@okkly/helpers": "workspace:*",
    "@okkly/icons": "workspace:*",
    "@okkly/react-hooks": "workspace:*",
    "@popperjs/core": "^2.11.8",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/experimental-ct-react": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/addon-designs": "^8.2.1",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "playwright-core": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass-embedded": "catalog:",
    "storybook": "^8.4.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=20"
  }
}
