{
  "name": "@okkly/angular",
  "version": "0.0.0",
  "description": "Okryshto design system — Angular component library",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovelycentury/okkly.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/lovelycentury/okkly/tree/main/packages/angular#readme",
  "bugs": "https://github.com/lovelycentury/okkly/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "module": "./dist/fesm2022/okkly-angular.mjs",
  "types": "./dist/types/okkly-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/okkly-angular.d.ts",
      "default": "./dist/fesm2022/okkly-angular.mjs"
    },
    "./style.css": {
      "default": "./dist/okkly-angular.css"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.build.json && pnpm run build:styles",
    "build:styles": "sass --no-source-map --load-path=node_modules src/styles.scss dist/okkly-angular.css",
    "dev": "ng-packagr -p ng-package.json -c tsconfig.build.json --watch",
    "typecheck": "pnpm run docs:json && tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --config ../oxlint-config/index.json .",
    "storybook": "pnpm run docs:json && storybook dev -p 6007 --no-open",
    "storybook:build": "pnpm run docs:json && storybook build",
    "docs:json": "compodoc -p tsconfig.build.json -e json -d . --disablePrivate --disableProtected --disableInternal --disableLifeCycleHooks"
  },
  "dependencies": {
    "@okkly/design-system": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/storybook-angular": "^2.7.0",
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/animations": "^21.0.0",
    "@angular/build": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@compodoc/compodoc": "^1.1.26",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/angular": "^10.6.0",
    "jsdom": "^25.0.1",
    "ng-packagr": "^21.0.0",
    "rxjs": "^7.8.1",
    "sass-embedded": "catalog:",
    "storybook": "^10.6.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@angular/common": ">=20",
    "@angular/core": ">=20"
  },
  "engines": {
    "node": ">=20"
  }
}
