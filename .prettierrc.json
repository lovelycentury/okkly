{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    {
      "files": ["*.md", "*.mdx"],
      "options": { "proseWrap": "preserve" }
    },
    {
      "comment": "Angular component templates: the html parser chokes on @if/@for blocks and {{ }}.",
      "files": ["packages/angular/src/**/*.html"],
      "options": { "parser": "angular" }
    },
    {
      "files": ["*.svelte"],
      "options": { "parser": "svelte" }
    }
  ]
}
