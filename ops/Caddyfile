# Inner Caddy: HTTP only, no host ports. TLS is terminated one hop up
# (~/vps-infra Caddy); this one only serves storybook.okryshto.dev.

{
	auto_https off

	servers {
		trusted_proxies static private_ranges
	}
}

(common) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

http://storybook.okryshto.dev {
	import common
	reverse_proxy storybook:80
}
