# syntax=docker/dockerfile:1.7
#
# Storybook — static build of one framework package, picked by build arg.
#
# BUILD CONTEXT IS THE MONOREPO ROOT:
#   docker build -f ops/Dockerfile.storybook --build-arg PACKAGE=vue -t storybook-vue .
#
# PACKAGE is one of: react, vue, svelte, angular. Workspace deps
# (@okkly/design-system, /icons, /shared, /react-hooks) are built first via
# the "..." filter. Runtime is spa.Caddyfile.

ARG PACKAGE=react

FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    CI="true"
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm fetch

FROM deps AS build
ARG PACKAGE
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline
# Workspace package dist first (Storybook resolves them from packages/*/dist),
# then the static Storybook build → packages/<package>/storybook-static.
RUN pnpm --filter "@okkly/${PACKAGE}..." --if-present run build
RUN pnpm --filter "@okkly/${PACKAGE}" run storybook:build

FROM caddy:2-alpine AS runtime
ARG PACKAGE
COPY ops/spa.Caddyfile /etc/caddy/Caddyfile
COPY --from=build /repo/packages/${PACKAGE}/storybook-static /srv
EXPOSE 80
